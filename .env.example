# Copy this file to `.env` and fill in real values.
# `.env` is in .gitignore — never commit actual tokens.

# --- Gemini (drives fix_llm_agent) ---
# From https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-gemini-api-key

# --- SonarQube instance ---
SONAR_BASE_URL=http://localhost:9000
# Sonar UI > My Account > Security > Generate Token
SONAR_TOKEN=your-sonar-token
# CE_EDITION=true runs a LOCAL working-tree scan against the checked-out
# branch (Community Edition has no branch analysis). Leave true even on
# paid editions — _scanned_branch() probes the server directly rather than
# trusting this flag.
CE_EDITION=true
# sonar.projectKey is NOT set here — SetupStep reads it from the checked-out
# repo's own pom.xml / build.gradle (Java) or sonar-project.properties
# (TypeScript) so it always matches what the Sonar plugin/scanner scans under.

# --- Source: pick ONE mode ---
# "local" reads SOURCE_PATH directly. "github" clones GITHUB_REPO into
# WORKSPACE_ROOT using GITHUB_TOKEN for auth.
SOURCE_TYPE=local

# Used when SOURCE_TYPE=local — absolute or ~-relative path to the repo
# (a Java project's root, or an Angular project's root — wherever
# angular.json lives)
SOURCE_PATH=~/path/to/your/project

# Used when SOURCE_TYPE=github — "owner/repo" or full https URL
GITHUB_REPO=owner/repo
# Fine-grained PAT with Contents: Read & write on the target repo (needed
# only to push the fix branch; leave blank for read-only public repos).
GITHUB_TOKEN=your-github-pat
# Base for github-mode clones. Each agent clones into its own sibling dir
# under the same parent: /tmp/sonar_remediation_{techdebt,coverage,duplicate}/
# (only this path's parent is used). Local source is edited in place.
WORKSPACE_ROOT=/tmp/sonar_remediation_workspaces

# --- Language / build ---
# "java" auto-detects Maven vs Gradle from pom.xml / build.gradle[.kts] in
# the repo root. Set "java-maven" or "java-gradle" explicitly only if the
# repo has files for both or a non-standard layout.
# "typescript" auto-detects Karma vs Vitest from package.json's
# dependencies (an Angular project). Set "typescript-karma" or
# "typescript-vitest" explicitly only if the repo has both or a
# non-standard layout. Requires a JUnit-XML test reporter configured —
# karma-junit-reporter for Karma (Vitest ships one built in) — the agent's
# preflight check explains exactly what's missing and how to add it if not.
LANGUAGE=java

# --- Optional ---
# A specific branch to check out and fix instead of the repo's default.
# That branch must already have its own Sonar analysis. A chat user can
# instead just say "on the develop branch".
# SOURCE_BRANCH=develop
# Caps fix_llm_agent's Gemini thinking effort per file: MINIMAL/LOW/MEDIUM/HIGH.
# FIX_LLM_THINKING_LEVEL=LOW
