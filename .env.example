# Copy this file to `.env` and fill in real values.
# `.env` itself must be in .gitignore — never commit actual tokens.

# --- Gemini (drives fix_llm_agent) ---
# From https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# --- Local SonarQube instance ---
# Community Edition only analyzes the main branch — this agent runs a
# LOCAL working-tree scan against the checked-out branch instead of a
# pushed one (Section 7 of the design doc). Nothing is pushed to the
# shared Sonar project until the branch is merged.
SONAR_BASE_URL=http://localhost:9000
# User > My Account > Security > Generate Token in the Sonar UI
SONAR_TOKEN=
SONAR_PROJECT_KEY=
CE_EDITION=true

# --- Source: pick ONE mode ---
# "local" reads SOURCE_PATH directly. "github" clones REPO_URL into
# WORKSPACE_ROOT using GITHUB_TOKEN for auth.
SOURCE_TYPE=local

# Used when SOURCE_TYPE=local — absolute or ~-relative path to the repo
SOURCE_PATH=~/code/my-project

# Used when SOURCE_TYPE=github — "owner/repo" or full https URL
GITHUB_REPO=owner/repo-name
# Settings > Developer settings > Personal access tokens (fine-grained;
# needs Contents: Read & write on the target repo so the agent can push
# its fix branch). Leave blank for public repos you only need to read —
# required if you want the agent to push the branch back.
GITHUB_TOKEN=
# Where github-mode clones land locally
WORKSPACE_ROOT=/tmp/sonar_autofix_workspaces

# --- Language / build ---
# "java" auto-detects Maven vs Gradle from pom.xml / build.gradle[.kts] in
# the repo root. Set explicitly to "java-maven" or "java-gradle" only if
# the repo has files for both (ambiguous) or a non-standard layout.
LANGUAGE=java

# --- Commit identity for the agent's own commits ---
GIT_AUTHOR_NAME=sonar-autofix-agent
GIT_AUTHOR_EMAIL=sonar-autofix-agent@local
