# Environments
.env
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Testing / tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Editors / OS
.vscode/
.idea/
.DS_Store

# Logs
*.log

# ADK local runtime state (session DB accumulates full chat/event history
# from local dev runs, including repo URLs and model output -- not
# meant to be shared or version-controlled)
.adk/

# OpenTofu -- state lives in the remote GCS backend (see infra/README.md),
# never locally or in git. Plan files can contain secret VALUES in
# plaintext (e.g. a freshly generated session-secret password), so they
# must never be committed either. .terraform/ is just downloaded provider
# binaries, fully regenerated by `tofu init`.
**/.terraform/
*.tfplan
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfvars
*.tfvars.json
