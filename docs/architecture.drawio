        <mxCell id="an42" value="SonarQube Server&#10;(user-provided)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#F5F5F5;strokeColor=#666666;dashed=1;" vertex="1" parent="a1">
