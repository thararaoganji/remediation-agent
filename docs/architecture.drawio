          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="an46" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#999999;fontSize=10;" edge="1" parent="a1" source="an21" target="an42">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="an47" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#999999;fontSize=10;" edge="1" parent="a1" source="an23" target="an42">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="an48" value="fetch source,&#10;push fix branch" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#999999;fontSize=10;" edge="1" parent="a1" source="an19" target="an43">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="an49" value="code analysis &amp; fix&#10;generation (via LiteLlm)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#999999;fontSize=10;" edge="1" parent="a1" source="an19" target="an44">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="an50" value="Known gotchas (found the hard way this project): Container Apps Jobs' begin_start REPLACES the whole container definition, so the&#10;per-run env override must be merged with the job's baked-in vars, not just swapped in · log_analytics_workspace_id only takes effect at&#10;environment CREATION time, not via update on an existing one · &quot;Container Apps Contributor&quot; does NOT cover Container Apps JOBS — needs&#10;the separate &quot;Container Apps Jobs Operator&quot; role too" style="text;html=1;align=left;verticalAlign=top;fontSize=10.5;fontColor=#8a4b00;fontStyle=2;fillColor=#FFF8E1;strokeColor=#B8860B;rounded=1;spacing=8;" vertex="1" parent="a1">
          <mxGeometry x="20" y="625" width="1660" height="75" as="geometry" />
        </mxCell>
        <mxCell id="an51" value="Cloud-agnostic facade: storage.py · secrets.py · job_runner.py · run_status.py — picked by CLOUD_PROVIDER env var" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#666666;fontStyle=2;" vertex="1" parent="a1">
          <mxGeometry x="60" y="710" width="980" height="25" as="geometry" />
        </mxCell>
        <mxCell id="an52" value="Tech Stack" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=15;fontStyle=1;fillColor=#FFF8E1;strokeColor=#B8860B;arcSize=4;" vertex="1" parent="a1">
          <mxGeometry x="60" y="745" width="1620" height="60" as="geometry" />
        </mxCell>
        <mxCell id="an53" value="Frontend: React 18 + Vite   ·   Backend: FastAPI (Python)   ·   Agent Core: Python + Google ADK (LiteLlm for non-Google vendors)   ·   IaC: OpenTofu (one root per cloud per environment)   ·   CI/CD: GitHub Actions, reusable workflows + composite actions, manual trigger only" style="text;html=1;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#333333;" vertex="1" parent="a1">
          <mxGeometry x="80" y="780" width="1580" height="20" as="geometry" />
        </mxCell>
        <mxCell id="an54" value="Legend:  solid arrow = call/data flow · dashed box = external system, not owned by this repo" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;fontStyle=2;" vertex="1" parent="a1">
          <mxGeometry x="20" y="825" width="1660" height="25" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page-agents" name="The 3 Agents">
    <mxGraphModel dx="1700" dy="1250" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1250" math="0" shadow="0">
      <root>
        <mxCell id="gt0" />
        <mxCell id="gt1" parent="gt0" />
        <mxCell id="gtn2" value="Sonar Remediation Agent — How Each of the 3 Agents Works" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#222222;" vertex="1" parent="gt1">
          <mxGeometry x="20" y="10" width="1660" height="30" as="geometry" />
        </mxCell>
        <mxCell id="gtn3" value="All three share the same engine (setup · checkpoint · outer-loop · push, in core/ and sonar/) — only what each agent fetches, generates, and verifies per file is agent-specific." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#666666;fontStyle=2;" vertex="1" parent="gt1">
          <mxGeometry x="20" y="42" width="1660" height="22" as="geometry" />
        </mxCell>
        <mxCell id="gtn4" value="Tech-Debt Agent&#10;Fixes Security, Reliability &amp; Maintainability findings" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fontStyle=1;fillColor=#4285F4;strokeColor=none;fontColor=#FFFFFF;" vertex="1" parent="gt1">
          <mxGeometry x="20" y="80" width="520" height="55" as="geometry" />
        </mxCell>
        <mxCell id="gtn5" value="Coverage Agent&#10;Writes JUnit tests for uncovered code" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fontStyle=1;fillColor=#34A853;strokeColor=none;fontColor=#FFFFFF;" vertex="1" parent="gt1">
          <mxGeometry x="570" y="80" width="520" height="55" as="geometry" />
        </mxCell>
        <mxCell id="gtn6" value="Duplicate Agent&#10;Extracts duplicated code into shared helpers" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fontStyle=1;fillColor=#9333EA;strokeColor=none;fontColor=#FFFFFF;" vertex="1" parent="gt1">
          <mxGeometry x="1120" y="80" width="520" height="55" as="geometry" />
        </mxCell>
        <mxCell id="gtn7" value="1. Setup&#10;Clone/checkout the repo, auto-detect the build tool (Maven/Gradle) and Java version, validate the SonarQube connection, create a fresh working branch ({project}_agent_&lt;timestamp&gt;)." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#4285F4;" vertex="1" parent="gt1">
          <mxGeometry x="20" y="150" width="520" height="75" as="geometry" />
        </mxCell>
        <mxCell id="gtn8" value="1. Setup&#10;Clone/checkout the repo, auto-detect the build tool (Maven/Gradle) and Java version, validate the SonarQube connection, create a fresh working branch ({project}_agent_&lt;timestamp&gt;)." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#34A853;" vertex="1" parent="gt1">
          <mxGeometry x="570" y="150" width="520" height="75" as="geometry" />
        </mxCell>
        <mxCell id="gtn9" value="1. Setup&#10;Clone/checkout the repo, auto-detect the build tool (Maven/Gradle) and Java version, validate the SonarQube connection, create a fresh working branch ({project}_agent_&lt;timestamp&gt;)." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#9333EA;" vertex="1" parent="gt1">
          <mxGeometry x="1120" y="150" width="520" height="75" as="geometry" />
        </mxCell>
        <mxCell id="gtn10" value="2. Baseline&#10;N/A — the final Sonar ratings themselves are this agent's before/after signal." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#4285F4;" vertex="1" parent="gt1">
          <mxGeometry x="20" y="235" width="520" height="60" as="geometry" />
        </mxCell>
        <mxCell id="gtn11" value="2. Baseline&#10;Requires JaCoCo configured (fails fast with setup instructions if missing). Records the project's current test coverage %." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#34A853;" vertex="1" parent="gt1">
          <mxGeometry x="570" y="235" width="520" height="60" as="geometry" />
        </mxCell>
        <mxCell id="gtn12" value="2. Baseline&#10;Records the project's current duplicated-lines density % before touching anything." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#9333EA;" vertex="1" parent="gt1">
          <mxGeometry x="1120" y="235" width="520" height="60" as="geometry" />
        </mxCell>
        <mxCell id="gtn13" value="3. Fetch &amp; prioritize&#10;Pull Security/Reliability/Maintainability findings (Critical/High/Medium), sort by severity, split into an auto-fix queue and a manual-review queue." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#4285F4;" vertex="1" parent="gt1">
          <mxGeometry x="20" y="305" width="520" height="70" as="geometry" />
        </mxCell>
        <mxCell id="gtn14" value="3. Fetch &amp; prioritize&#10;Pull the files with the lowest test coverage first (most impactful files fixed first)." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#34A853;" vertex="1" parent="gt1">
          <mxGeometry x="570" y="305" width="520" height="70" as="geometry" />
        </mxCell>
        <mxCell id="gtn15" value="3. Fetch &amp; prioritize&#10;Pull the files that contain duplicated code blocks, most-duplicated first." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#9333EA;" vertex="1" parent="gt1">
          <mxGeometry x="1120" y="305" width="520" height="70" as="geometry" />
        </mxCell>
        <mxCell id="gtn16" value="4. Generate a fix&#10;A handful of rules have one unambiguous fix applied mechanically first (no LLM needed). Everything else: ask the LLM for a diff against the existing file." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#4285F4;" vertex="1" parent="gt1">
          <mxGeometry x="20" y="385" width="520" height="85" as="geometry" />
        </mxCell>
        <mxCell id="gtn17" value="4. Generate a test&#10;Ask the LLM to WRITE A NEW JUnit test file targeting the specific uncovered lines/branches (a new file, not a diff to existing source)." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#34A853;" vertex="1" parent="gt1">
          <mxGeometry x="570" y="385" width="520" height="85" as="geometry" />
        </mxCell>
        <mxCell id="gtn18" value="4. Generate a refactor&#10;Ask the LLM for a diff that extracts the duplicated logic into a clean, reusable helper method/class." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#9333EA;" vertex="1" parent="gt1">
          <mxGeometry x="1120" y="385" width="520" height="85" as="geometry" />
        </mxCell>
        <mxCell id="gtn19" value="5. Apply &amp; verify&#10;Apply the change, then quick compile check. Diff rejected or won't compile → retry as a full-file rewrite. Still failing → narrow single-issue retry. Still no good → flag the file for manual review and move on." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#4285F4;" vertex="1" parent="gt1">
          <mxGeometry x="20" y="480" width="520" height="100" as="geometry" />
        </mxCell>
        <mxCell id="gtn20" value="5. Apply &amp; verify&#10;Apply the change, then compile AND run the new test. Diff rejected or won't compile → retry as a full-file rewrite. Still failing → narrow single-issue retry. Still no good → flag the file for manual review and move on." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#34A853;" vertex="1" parent="gt1">
          <mxGeometry x="570" y="480" width="520" height="100" as="geometry" />
        </mxCell>
        <mxCell id="gtn21" value="5. Apply &amp; verify&#10;Apply the change, then quick compile check. Diff rejected or won't compile → retry as a full-file rewrite. Still failing → narrow single-issue retry. Still no good → flag the file for manual review and move on." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#9333EA;" vertex="1" parent="gt1">
          <mxGeometry x="1120" y="480" width="520" height="100" as="geometry" />
        </mxCell>
        <mxCell id="gtn22" value="6. Checkpoint&#10;Every batch of files: commit, trigger a full SonarQube re-scan + full project build/test. A regression or new issue → bisect and revert just the offending file(s), not the whole batch." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#4285F4;" vertex="1" parent="gt1">
          <mxGeometry x="20" y="590" width="520" height="85" as="geometry" />
        </mxCell>
        <mxCell id="gtn23" value="6. Checkpoint&#10;Every batch of files: commit, trigger a full SonarQube re-scan + full project build/test. A regression or new issue → bisect and revert just the offending file(s), not the whole batch." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#34A853;" vertex="1" parent="gt1">
          <mxGeometry x="570" y="590" width="520" height="85" as="geometry" />
        </mxCell>
        <mxCell id="gtn24" value="6. Checkpoint&#10;Every batch of files: commit, trigger a full SonarQube re-scan + full project build/test. A regression or new issue → bisect and revert just the offending file(s), not the whole batch." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#9333EA;" vertex="1" parent="gt1">
          <mxGeometry x="1120" y="590" width="520" height="85" as="geometry" />
        </mxCell>
        <mxCell id="gtn25" value="7. Repeat&#10;Fetch → fix → checkpoint again, until the queue is empty or the iteration cap (5) is hit." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#4285F4;" vertex="1" parent="gt1">
          <mxGeometry x="20" y="685" width="520" height="50" as="geometry" />
        </mxCell>
        <mxCell id="gtn26" value="7. Repeat&#10;Fetch → fix → checkpoint again, until the queue is empty or the iteration cap (5) is hit." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#34A853;" vertex="1" parent="gt1">
          <mxGeometry x="570" y="685" width="520" height="50" as="geometry" />
        </mxCell>
        <mxCell id="gtn27" value="7. Repeat&#10;Fetch → fix → checkpoint again, until the queue is empty or the iteration cap (5) is hit." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#9333EA;" vertex="1" parent="gt1">
          <mxGeometry x="1120" y="685" width="520" height="50" as="geometry" />
        </mxCell>
        <mxCell id="gtn28" value="8. Maintainability top-up&#10;If the Maintainability debt ratio is still below an A after the main pass, one more targeted pass on the highest-debt-minutes Minor/Low smells." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#4285F4;" vertex="1" parent="gt1">
          <mxGeometry x="20" y="745" width="520" height="85" as="geometry" />
        </mxCell>
        <mxCell id="gtn29" value="8. Quality gate&#10;Check whether the new test files (or the production files they touch) introduced any new Maintainability smells; fix those too, reusing the Tech-Debt agent's own fix engine." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#34A853;" vertex="1" parent="gt1">
          <mxGeometry x="570" y="745" width="520" height="85" as="geometry" />
        </mxCell>
        <mxCell id="gtn30" value="8. Quality gate&#10;Check whether the extracted helper itself introduced any new Maintainability smells; fix those too, reusing the Tech-Debt agent's own fix engine." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#9333EA;" vertex="1" parent="gt1">
          <mxGeometry x="1120" y="745" width="520" height="85" as="geometry" />
        </mxCell>
        <mxCell id="gtn31" value="9. Push &amp; report&#10;Push the branch to GitHub (skipped if nothing changed). Final report: Security/Reliability/Maintainability ratings, issues fixed, push result, duration, LLM tokens used." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#4285F4;" vertex="1" parent="gt1">
          <mxGeometry x="20" y="840" width="520" height="95" as="geometry" />
        </mxCell>
        <mxCell id="gtn32" value="9. Push &amp; report&#10;Push the branch to GitHub (skipped if nothing changed). Final report: coverage % before → after, tests added, push result, duration." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#34A853;" vertex="1" parent="gt1">
          <mxGeometry x="570" y="840" width="520" height="95" as="geometry" />
        </mxCell>
        <mxCell id="gtn33" value="9. Push &amp; report&#10;Push the branch to GitHub (skipped if nothing changed). Final report: duplication density % before → after, files refactored, push result, duration." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#9333EA;" vertex="1" parent="gt1">
          <mxGeometry x="1120" y="840" width="520" height="95" as="geometry" />
        </mxCell>
        <mxCell id="gtn34" value="Shared engine (identical code across all three): sonar/setup.py · sonar/checkpoint.py · core/agents/fix_loop.py (LLM-call gate + retry ladder) · core/agents/outer_loop.py · core/agents/checkpoint.py · core/agents/report.py (push step). Agent-specific code: fetch/prioritize, the fix/test/refactor prompt, and the per-file verify step." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;fontStyle=2;" vertex="1" parent="gt1">
          <mxGeometry x="20" y="950" width="1660" height="40" as="geometry" />
        </mxCell>
      </root>
