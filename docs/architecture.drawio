        </mxCell>
        <mxCell id="an43" value="GitHub&#10;(source repo, fix branch push)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#F5F5F5;strokeColor=#666666;dashed=1;" vertex="1" parent="a1">
          <mxGeometry x="1120" y="360" width="220" height="55" as="geometry" />
        </mxCell>
